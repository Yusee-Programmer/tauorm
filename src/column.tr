# tauorm.column — Column: a named, typed table column with the handful of
# constraints DDL generation needs (primary key, nullability, uniqueness).
#
# Builder-style chaining (`Column.init("id", Integer()).pk()`) mutates and
# returns `self` rather than returning a new copy -- classes are heap
# (reference) types in Tauraro, so this is the normal, zero-copy pattern
# (matches how e.g. `mut b = Box[T].of(v)` factories work throughout this
# codebase already), not aliasing risk the way it would be for a value type.

from col_types import ColumnType

pub class Column:
    pub name:          str
    pub col_type:      ColumnType
    pub primary_key:   bool
    pub nullable:      bool
    pub unique:        bool
    # Foreign key target: "" / "" when this column isn't one. Phase 4
    # (relationships) is the first consumer -- see relationship.tr's
    # load_many()/load_one(), which query by the FK column's VALUE and
    # don't actually need this DDL-level metadata to function (SQLite
    # doesn't even enforce FK constraints unless a session explicitly
    # turns on `PRAGMA foreign_keys`), but a Table that's meant to
    # document its own relationships honestly should still carry it.
    pub ref_table:     str
    pub ref_column:    str

extend Column:
    pub def init(name: str, col_type: ColumnType) -> Column:
        mut c = Column()
        c.name = name
        c.col_type = col_type
        c.primary_key = false
        c.nullable = true
        c.unique = false
        c.ref_table = ""
        c.ref_column = ""
        return c

    pub def pk(self) -> Column:
        self.primary_key = true
        self.nullable = false
        return self

    pub def not_null(self) -> Column:
        self.nullable = false
        return self

    pub def is_unique(self) -> Column:
        self.unique = true
        return self

    # Marks this column as a foreign key referencing another table's
    # column, e.g. `Column.init("user_id", Integer()).references("User", "id")`.
    pub def references(self, table: str, column: str) -> Column:
        self.ref_table = table
        self.ref_column = column
        return self

    # The DDL fragment for this column inside a CREATE TABLE's column list,
    # e.g. "id SERIAL PRIMARY KEY" (Postgres) / "id INTEGER PRIMARY KEY"
    # (SQLite -- an INTEGER PRIMARY KEY column there is itself an alias for
    # the table's own rowid and behaves like autoincrement, so it doesn't
    # need SQLite's separate, rarely-recommended AUTOINCREMENT keyword).
    #
    # This renders an INLINE (per-column) PRIMARY KEY -- correct only when
    # this is the table's ONE primary-key column. A COMPOSITE (multi-
    # column) primary key can't be expressed per-column in SQL at all; see
    # `ddl_no_pk` + `Table.create_sql`'s own header comment for how a
    # table with more than one `primary_key`-flagged column renders a
    # table-level `PRIMARY KEY (a, b)` constraint instead.
    pub def ddl(self, dialect: str) -> str:
        if self.primary_key and self.col_type.kind == "integer":
            if dialect == "postgres":
                return self.name + " SERIAL PRIMARY KEY"
            return self.name + " INTEGER PRIMARY KEY"
        mut sql = self.name + " " + self.col_type.ddl(dialect)
        if self.primary_key:
            sql = sql + " PRIMARY KEY"
        elif not self.nullable:
            sql = sql + " NOT NULL"
        if self.unique:
            sql = sql + " UNIQUE"
        if self.ref_table != "":
            sql = sql + " REFERENCES " + self.ref_table + "(" + self.ref_column + ")"
        return sql

    # Same as `ddl`, but never renders an inline `PRIMARY KEY` (even if
    # `self.primary_key` is set) -- used by `Table.create_sql` for every
    # column when the table has a COMPOSITE primary key (2+ columns with
    # `primary_key = true`), since the key is instead expressed once, as
    # a trailing table-level `PRIMARY KEY (a, b, ...)` constraint. NOT NULL
    # is still emitted explicitly here for a primary-key column (a
    # composite key's member columns are still non-nullable -- `pk()`
    # already sets `nullable = false` -- just not expressed via the
    # inline `PRIMARY KEY` keyword this method omits).
    pub def ddl_no_pk(self, dialect: str) -> str:
        mut sql = self.name + " " + self.col_type.ddl(dialect)
        if not self.nullable:
            sql = sql + " NOT NULL"
        if self.unique:
            sql = sql + " UNIQUE"
        if self.ref_table != "":
            sql = sql + " REFERENCES " + self.ref_table + "(" + self.ref_column + ")"
        return sql
