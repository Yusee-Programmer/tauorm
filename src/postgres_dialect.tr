# tauorm.postgres_dialect — the Postgres DbConnection/DbResultSet
# implementation, wrapping taupostgres's Connection/PgResult/Row.
#
# taupostgres materializes the WHOLE result set up front (PgResult) rather
# than stepping through rows one at a time; PostgresResultSet just walks
# that already-materialized set to satisfy dbapi.tr's step-cursor shape.
# `index` starts at -1 (before the first row); next() increments it first,
# then reports whether a row is available at the new position. No text
# normalization needed here (an earlier, since-abandoned design forced
# every value through a shared text representation) -- get_bool()/get_int()/
# etc. just delegate straight to Row's own typed accessors.
#
# `implements DbConnection[PostgresResultSet]` is explicit (not left to
# structural inference) because PostgresConnection is a non-generic class
# implementing a GENERIC interface with a concrete type argument -- an
# earlier tauraroc version silently discarded interface type arguments in
# this position; now fixed, see PROPOSAL.md's Status section.
#
# `PostgresResultSet implements DbResultSet` is ALSO explicit, for the
# same reason sqlite_dialect.tr's PostgresResultSet-equivalent needs it --
# see that file's header comment: tauraroc only generates a class-to-
# interface boxing wrapper for an EXPLICIT `implements`, never for a
# purely structural match (the kind a generic bound like `RS: DbResultSet`
# is satisfied by), and `Mapper[T].load: def(DbResultSet) -> T` needs that
# wrapper to box a concrete result-set value before calling through it.
#
# NOT re-exported by tauorm.tr's hub: importing this module requires the
# `postgres` package (taupkg's `postgres` feature) to be installed. A
# consumer who built without that feature must never have this module's
# `from postgres import ...` resolved at all -- see taupkg.toml's header
# comment on why the hub only re-exports backend-agnostic Core.
#
# Error translation: a bare call to a `throws E` function (no `?`) yields
# the raw `Result[T, E]` rather than auto-raising or auto-unwrapping (see
# tests/lang/05_error_handling.tr's "mixed models" section upstream) --
# `?` itself does an early RETURN of the Err Result directly to the
# caller, bypassing any try/except in the SAME function, so it can't be
# used here either. Every call is therefore checked via
# `.is_err`/`.ok`/`.err` and re-raised as DbError. This also preserves
# PgError's structured `sqlstate` into DbError.code -- `try:/except e:`
# would lose it (binds only the exception's stringified form, confirmed
# empirically) even though it compiles and `--check`s clean.

from postgres import Connection, PgResult, PgError
from dbapi import DbConnection, DbResultSet
from db_error import DbError
from std.core.vec import Vec

pub class PostgresResultSet implements DbResultSet:
    pub pg_result: PgResult
    pub index:     int

extend PostgresResultSet:
    pub def wrap(r: PgResult) -> PostgresResultSet:
        mut rs = PostgresResultSet()
        rs.pg_result = r
        rs.index = -1
        return rs

    pub def column_count(self) -> int:
        return self.pg_result.column_count()

    pub def column_name(self, idx: int) -> str:
        return self.pg_result.column_name(idx)

    pub def next(self) throws DbError -> bool:
        self.index = self.index + 1
        return self.index < self.pg_result.ntuples()

    pub def get_str(self, idx: int) -> str:
        return self.pg_result.row(self.index).get_str(idx)

    pub def get_int(self, idx: int) -> int:
        return self.pg_result.row(self.index).get_int(idx)

    pub def get_float(self, idx: int) -> float:
        return self.pg_result.row(self.index).get_float(idx)

    pub def get_bool(self, idx: int) -> bool:
        return self.pg_result.row(self.index).get_bool(idx)

    pub def is_null(self, idx: int) -> bool:
        return self.pg_result.row(self.index).is_null(idx)

    pub def rows_affected(self) -> int:
        return self.pg_result.affected_rows()

    pub def release(self):
        self.pg_result.clear()


pub class PostgresConnection implements DbConnection[PostgresResultSet]:
    pub conn: Connection

extend PostgresConnection:
    pub def open(conninfo: str) throws DbError -> PostgresConnection:
        mut r: Result[Connection, PgError] = Connection.connect(conninfo)
        if r.is_err:
            raise(DbError.init(r.err.sqlstate, r.err.message))
        mut pc = PostgresConnection()
        pc.conn = r.ok
        return pc

    pub def execute(self, sql: str, params: Vec[str]) throws DbError -> PostgresResultSet:
        mut r: Result[PgResult, PgError] = self.conn.exec_params(sql, params)
        if r.is_err:
            raise(DbError.init(r.err.sqlstate, r.err.message))
        return PostgresResultSet.wrap(r.ok)

    pub def begin(self) throws DbError:
        mut r: Result[void, PgError] = self.conn.begin()
        if r.is_err:
            raise(DbError.init(r.err.sqlstate, r.err.message))

    pub def commit(self) throws DbError:
        mut r: Result[void, PgError] = self.conn.commit()
        if r.is_err:
            raise(DbError.init(r.err.sqlstate, r.err.message))

    pub def rollback(self) throws DbError:
        mut r: Result[void, PgError] = self.conn.rollback()
        if r.is_err:
            raise(DbError.init(r.err.sqlstate, r.err.message))

    pub def release(self):
        self.conn.close()
