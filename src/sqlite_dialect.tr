# tauorm.sqlite_dialect — the SQLite DbConnection/DbResultSet
# implementation, wrapping tausqlite3's Connection/Statement.
#
# tausqlite3's Statement is already a step-cursor, so SqliteResultSet is a
# thin wrapper: next() delegates straight to stmt.step(), which already
# returns exactly dbapi.tr's next() contract (true = a row is available,
# false = exhausted).
#
# get_str() forces a copy (`+ ""`) rather than returning tausqlite3's
# column_str() result directly: that's a raw pointer cast into SQLite's own
# column buffer (confirmed by reading tausqlite3's implementation -- no
# allocation happens), valid only until the NEXT step() call reuses it.
# Caught this the hard way as a real, silent-until-runtime bug: a caller
# that stores a row's string across an iteration (the normal thing to do)
# read back corrupted memory despite a clean compile. Postgres's
# PostgresResultSet doesn't need the same defensive copy -- taupostgres's
# PgResult keeps every row alive until close()/clear(), a wider validity
# window than SQLite's per-step reuse.
#
# execute()'s `params: Vec[str]` binds every parameter as text via
# bind_str(), matching taupostgres's exec_params() (all-text params) rather
# than tausqlite3's own typed bind_int/bind_float/bind_null -- SQLite's
# type affinity coerces the text back to the column's declared type, the
# same way Postgres's text protocol does. Consistent behavior across
# dialects matters more here than using SQLite's typed binds; a typed
# execute() path (mirroring taupostgres's exec_params_binary()) can follow
# later without changing this interface.
#
# `implements DbConnection[SqliteResultSet]` is explicit -- see
# postgres_dialect.tr's header comment for why.
#
# NOT re-exported by tauorm.tr's hub -- see postgres_dialect.tr's header
# comment; the same reasoning applies (this module requires the `sqlite3`
# package / taupkg's `sqlite` feature).
#
# Error translation: see postgres_dialect.tr's header comment on the
# Result[T,E]-based idiom used throughout -- it's what lets SqliteError's
# structured `code` survive into DbError.code.

from sqlite3 import Connection, Statement, SqliteError
from dbapi import DbConnection
from db_error import DbError
from std.core.vec import Vec

pub class SqliteResultSet:
    pub stmt: Statement
    pub conn: Connection

extend SqliteResultSet:
    pub def wrap(stmt: Statement, conn: Connection) -> SqliteResultSet:
        mut rs = SqliteResultSet()
        rs.stmt = stmt
        rs.conn = conn
        return rs

    pub def column_count(self) -> int:
        return self.stmt.column_count()

    pub def column_name(self, idx: int) -> str:
        return self.stmt.column_name(idx) + ""

    pub def next(self) throws DbError -> bool:
        mut r: Result[bool, SqliteError] = self.stmt.step()
        if r.is_err:
            raise(DbError.init(r.err.code.to_str(), r.err.message))
        return r.ok

    pub def get_str(self, idx: int) -> str:
        return self.stmt.column_str(idx) + ""

    pub def get_int(self, idx: int) -> int:
        return self.stmt.column_int(idx)

    pub def get_float(self, idx: int) -> float:
        return self.stmt.column_float(idx)

    pub def get_bool(self, idx: int) -> bool:
        return self.stmt.column_int(idx) != 0

    pub def is_null(self, idx: int) -> bool:
        return self.stmt.column_is_null(idx)

    # SQLite's changes() is a CONNECTION-level count of rows changed by the
    # most recently completed INSERT/UPDATE/DELETE -- accurate here as long
    # as callers finish stepping a write statement to completion (DONE)
    # before reading rows_affected(), the same expectation SQLite itself
    # has of sqlite3_changes().
    pub def rows_affected(self) -> int:
        return self.conn.changes()

    pub def release(self):
        self.stmt.finalize()


pub class SqliteConnection implements DbConnection[SqliteResultSet]:
    pub conn: Connection

extend SqliteConnection:
    pub def open(path: str) throws DbError -> SqliteConnection:
        mut r: Result[Connection, SqliteError] = Connection.open(path)
        if r.is_err:
            raise(DbError.init(r.err.code.to_str(), r.err.message))
        mut sc = SqliteConnection()
        sc.conn = r.ok
        return sc

    pub def execute(self, sql: str, params: Vec[str]) throws DbError -> SqliteResultSet:
        mut prep: Result[Statement, SqliteError] = self.conn.prepare(sql)
        if prep.is_err:
            raise(DbError.init(prep.err.code.to_str(), prep.err.message))
        mut stmt = prep.ok

        mut i = 0
        while i < params.len:
            mut br: Result[void, SqliteError] = stmt.bind_str(i + 1, params.get(i))
            if br.is_err:
                raise(DbError.init(br.err.code.to_str(), br.err.message))
            i = i + 1

        return SqliteResultSet.wrap(stmt, self.conn)

    pub def begin(self) throws DbError:
        mut r: Result[void, SqliteError] = self.conn.begin()
        if r.is_err:
            raise(DbError.init(r.err.code.to_str(), r.err.message))

    pub def commit(self) throws DbError:
        mut r: Result[void, SqliteError] = self.conn.commit()
        if r.is_err:
            raise(DbError.init(r.err.code.to_str(), r.err.message))

    pub def rollback(self) throws DbError:
        mut r: Result[void, SqliteError] = self.conn.rollback()
        if r.is_err:
            raise(DbError.init(r.err.code.to_str(), r.err.message))

    pub def release(self):
        self.conn.close()
