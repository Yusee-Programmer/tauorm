# tests.test_dbapi_postgres — runs dbapi_shared's generic test suite
# against the Postgres dialect adapter. Needs a reachable PostgreSQL server
# (unlike the SQLite variant, which is in-memory) -- set
# TAUORM_TEST_PG_CONNINFO or edit the default below. See ../PROPOSAL.md; a
# docker-based fixture is planned once this package has a docs/ (matching
# tausqlite3's own tests/README.md pattern for its equivalent gap).
#
# See test_dbapi_sqlite.tr's header comment for why every throws-call here
# is bound to an explicit `Result[T, E]` rather than `?` or a bare call.
#
# Only imports what `--features postgres` installs; see
# postgres_dialect.tr's header comment for why this can't live in one file
# together with the SQLite variant.

from postgres_dialect import PostgresConnection, PostgresResultSet
from db_error import DbError
from dbapi_shared import run_shared_tests
from std.core.vec import Vec
from std.os import Env
from std.test import TestRunner

def main():
    mut t = TestRunner.init("dbapi (postgres dialect)")
    mut conninfo = Env.get_var("TAUORM_TEST_PG_CONNINFO")
    if conninfo.len() == 0:
        conninfo = "host=localhost dbname=postgres"

    mut open_r: Result[PostgresConnection, DbError] = PostgresConnection.open(conninfo)
    if open_r.is_err:
        t.fail("could not open Postgres connection (" + conninfo + "): " + open_r.err.message)
        t.summary()
        return

    mut conn = open_r.ok
    mut no_params: Vec[str] = Vec[str].init(0)
    mut drop_r: Result[PostgresResultSet, DbError] = conn.execute("DROP TABLE IF EXISTS t_users", no_params)
    if drop_r.is_err:
        t.fail("DROP TABLE failed: " + drop_r.err.message)
        t.summary()
        return
    drop_r.ok.release()

    run_shared_tests(t, conn)
    t.summary()
