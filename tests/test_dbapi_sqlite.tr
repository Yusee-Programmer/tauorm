# tests.test_dbapi_sqlite — runs dbapi_shared's generic test suite against
# the SQLite dialect adapter (in-memory, no server needed).
#
# Every throws-call is bound to an explicit `Result[T, E]` and checked via
# `.is_err`/`.ok`/`.err` rather than `?` or a bare call assigned straight to
# a typed variable -- confirmed the hard way: a bare call type-checks under
# `--check` but fails real codegen with "incompatible types when
# initializing type 'X *' using type 'Result'" wherever it appears,
# `main()` included -- taupostgres's own README shows that exact bare-call
# style and it does NOT actually compile as literally written. See
# postgres_dialect.tr's header comment for the same finding at the dialect
# adapter level.
#
# Only imports what `--features sqlite` installs; see
# sqlite_dialect.tr's header comment for why this can't live in one file
# together with the Postgres variant.

from sqlite_dialect import SqliteConnection
from db_error import DbError
from dbapi_shared import run_shared_tests
from std.test import TestRunner

def main():
    mut t = TestRunner.init("dbapi (sqlite dialect)")

    mut open_r: Result[SqliteConnection, DbError] = SqliteConnection.open(":memory:")
    if open_r.is_err:
        t.fail("could not open SQLite connection: " + open_r.err.message)
        t.summary()
        return

    run_shared_tests(t, open_r.ok)
    t.summary()
