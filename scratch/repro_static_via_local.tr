# Does assigning a static-method value reference to a local variable FIRST,
# then passing the VARIABLE (not the bare `Foo.make` expression) into a
# generic class's constructor, avoid the missing-drop-fn bug seen when
# `Foo.make` is passed directly (see repro_static_as_fnptr.tr)?

class Foo:
    pub n: int

extend Foo:
    pub def make(n: int) -> Foo:
        mut f = Foo()
        f.n = n
        return f

class Holder[T]:
    pub maker: def(int) -> T

extend Holder:
    pub def init[T](maker: def(int) -> T) -> Holder[T]:
        mut h = Holder[T]()
        h.maker = maker
        return h

    pub def build(self, n: int) -> T:
        return self.maker(n)

def main():
    mut mk: def(int) -> Foo = Foo.make
    mut h: Holder[Foo] = Holder[Foo].init(mk)
    mut f = h.build(42)
    print(f.n)
